@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sec: <https://w3id.org/security#> .
@prefix t: <urn:trial:> .

# The delegation chain, in ZCAP-LD's terms as its JSON-LD expands them.
t:root sec:controller t:alice ; sec:invocationTarget <https://app.example/mail> ; sec:allowedAction "Graph:*" .
t:c1 sec:parentCapability t:root ; sec:controller t:bob ; sec:invocationTarget <https://app.example/mail/inbox> ; sec:allowedAction "Graph:query" ;
  sec:expires "2026-12-01T00:00:00Z"^^xsd:dateTime .
t:c2 sec:parentCapability t:c1 ; sec:controller t:carol ; sec:invocationTarget <https://app.example/mail/inbox> ; sec:allowedAction "Graph:query" ;
  sec:expires "2026-11-15T00:00:00Z"^^xsd:dateTime .
t:c3 sec:parentCapability t:c1 ; sec:controller t:carol ; sec:invocationTarget <https://app.example/mail> ; sec:allowedAction "Graph:query" ;
  sec:expires "2026-11-15T00:00:00Z"^^xsd:dateTime .
t:c4 sec:parentCapability t:c1 ; sec:controller t:carol ; sec:invocationTarget <https://app.example/mail/inbox> ; sec:allowedAction "Graph:write" ;
  sec:expires "2026-11-15T00:00:00Z"^^xsd:dateTime .
t:c5 sec:parentCapability t:c1 ; sec:controller t:carol ; sec:invocationTarget <https://app.example/mail/inbox> ; sec:allowedAction "Graph:query" ;
  sec:expires "2027-01-01T00:00:00Z"^^xsd:dateTime .

# A grant to a delegate over a list, and two grants the delegate proposes to a second delegate, each bounded by the first.
t:listGrant sec:controller t:delegate ; sec:invocationTarget <https://app.example/lists> ; sec:allowedAction "List:addEntry" ;
  sec:expires "2027-06-01T00:00:00Z"^^xsd:dateTime .
t:subGrantPart t:boundedBy t:listGrant ; sec:controller t:subDelegate ; sec:invocationTarget <https://app.example/lists/part> ;
  sec:allowedAction "List:addEntry" ; sec:expires "2027-01-01T00:00:00Z"^^xsd:dateTime .
t:subGrantRemove t:boundedBy t:listGrant ; sec:controller t:subDelegate ; sec:invocationTarget <https://app.example/lists/part> ;
  sec:allowedAction "List:removeEntry" ; sec:expires "2027-01-01T00:00:00Z"^^xsd:dateTime .
