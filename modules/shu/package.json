{
	"name": "@haibun/shu",
	"version": "4.0.0-alpha.3",
	"type": "module",
	"description": "Haibun hypermedia SPA — renders any domain-driven application from stepper concerns",
	"exports": {
		"./schemas.js": {
			"haibun-source": "./src/domains/schemas.js",
			"default": "./build/domains/schemas.js"
		},
		"./current-subject.js": {
			"haibun-source": "./src/page/domains/current-subject.js",
			"default": "./build/page/domains/current-subject.js"
		},
		"./waypoints": "./waypoints",
		"./waypoints/*": "./waypoints/*",
		"./*": {
			"haibun-source": "./src/*",
			"default": "./build/*"
		}
	},
	"scripts": {
		"build": "tsc -b . && npm run bundle",
		"bundle": "node scripts/bundles.ts page",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome format --write .",
		"build:watch": "concurrently \"tsc -b . --watch --preserveWatchOutput\" \"npm run bundle -- --watch\""
	},
	"dependencies": {
		"@digitalbazaar/data-integrity": "^2.5.0",
		"@digitalbazaar/data-integrity-context": "^2.0.1",
		"@digitalbazaar/ecdsa-rdfc-2019-cryptosuite": "^1.3.0",
		"@digitalbazaar/http-signature-zcap-invoke": "^6.1.0",
		"@digitalbazaar/multikey-context": "^2.0.1",
		"@digitalbazaar/security-context": "^1.0.1",
		"@digitalbazaar/zcap": "^9.0.3",
		"@digitalbazaar/zcap-context": "^2.0.1",
		"@fontsource/noto-sans": "^5.3.0",
		"@haibun/core": "*",
		"@haibun/domain-storage": "*",
		"@haibun/logic": "*",
		"@haibun/web-playwright": "*",
		"@haibun/web-server-hono": "*",
		"@lit-labs/signals": "^0.3.0",
		"@lit-labs/virtualizer": "^2.1.1",
		"@lit/task": "^1.0.3",
		"@recogito/text-annotator": "^4.2.5",
		"3d-force-graph-vr": "^3.1.1",
		"aframe": "~1.7.1",
		"base58-universal": "^2.0.0",
		"d3-force-3d": "^3.0.6",
		"did-context": "^3.1.1",
		"dompurify": "^3.3.3",
		"jsonld-signatures": "^11.6.0",
		"lit": "^3.3.3",
		"markdown-it": "^14.0.0",
		"troika-three-text": "^0.52.4",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"devDependencies": {
		"@haibun/cli": "*",
		"@haibun/storage-fs": "*",
		"@haibun/storage-mem": "*",
		"@haibun/tooling": "*",
		"@types/markdown-it": "^14.1.2",
		"esbuild": "^0.28.2",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^28.1.0"
	}
}
