{
	"name": "@haibun/logic",
	"type": "module",
	"version": "4.0.0-alpha.3",
	"description": "The logic engine that proves every step: SWI-Prolog through swipl-wasm, and EYE as the N3 reasoner on the same runtime",
	"main": "build/logic-stepper.js",
	"files": ["build/**", "src/adapters/haibun.pl", "eye/**", "waypoints/**"],
	"exports": {
		".": "./build/logic-stepper.js",
		"./haibun.pl": "./src/adapters/haibun.pl",
		"./eye.qlf": "./eye/eye.qlf",
		"./waypoints": "./waypoints",
		"./waypoints/*": "./waypoints/*",
		"./*": {
			"haibun-source": "./src/*",
			"default": "./build/*"
		}
	},
	"scripts": {
		"build": "tsc -b .",
		"bench": "node scripts/q6-cost.mjs",
		"build:watch": "tsc -b . --watch",
		"prepublishOnly": "npm run build",
		"test": "vitest run"
	},
	"keywords": ["haibun", "logic", "prolog"],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@haibun/core": "*",
		"swipl-wasm": "8.2.5",
		"zod": "4.6.7"
	}
}
