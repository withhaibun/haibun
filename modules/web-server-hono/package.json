{
	"name": "@haibun/web-server-hono",
	"type": "module",
	"version": "4.0.0-alpha.3",
	"description": "Hono-based web server for haibun with MCP support",
	"main": "build/web-server-stepper.js",
	"files": ["build/**", "waypoints/**"],
	"exports": {
		".": "./build/web-server-stepper.js",
		"./defs.js": {
			"haibun-source": "./src/ports.js",
			"default": "./build/ports.js"
		},
		"./sse-transport.js": {
			"haibun-source": "./src/domains/transport.js",
			"default": "./build/domains/transport.js"
		},
		"./capability-auth.js": {
			"haibun-source": "./src/pipelines/capability-verifier.js",
			"default": "./build/pipelines/capability-verifier.js"
		},
		"./auth.js": {
			"haibun-source": "./src/adapters/auth.js",
			"default": "./build/adapters/auth.js"
		},
		"./cookie.js": {
			"haibun-source": "./src/adapters/cookie.js",
			"default": "./build/adapters/cookie.js"
		},
		"./served-folder.js": {
			"haibun-source": "./src/pipelines/served-folder.js",
			"default": "./build/pipelines/served-folder.js"
		},
		"./waypoints": "./waypoints",
		"./waypoints/*": "./waypoints/*",
		"./*": {
			"haibun-source": "./src/*",
			"default": "./build/*"
		}
	},
	"scripts": {
		"prepublishOnly": "tsc -b .",
		"build": "tsc -b .",
		"build:watch": "tsc -b . --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": ["haibun", "hono", "mcp", "web-server"],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@haibun/core": "*",
		"@hono/mcp": "^0.3.2",
		"@hono/node-server": "^2.1.5",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"hono": "^4.12.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@haibun/logic": "*",
		"@types/node": "^25.3.0"
	}
}
