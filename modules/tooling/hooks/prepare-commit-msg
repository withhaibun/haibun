#!/bin/sh
# States in each commit's message the net source lines it changes and the change in its count of declared steps, which the
# steps baseline records, so every commit shows both. A merge, a squash and an amended message already hold them. core's
# haibun-commit-summary classifies each file.
case "$2" in merge | squash | commit) exit 0 ;; esac
grep -q '^Net source lines: ' "$1" && exit 0
npx --no-install haibun-commit-summary >> "$1"
