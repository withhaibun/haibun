              "remote": {
                "type": "string"
              }
            },
            "required": [
              "remote"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "runPolicy": {
      "type": "string"
    },
    "appParameters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "options": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "group": {
      "type": "object",
      "properties": {
        "bases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filter": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "set": {
          "type": "string"
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clears": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "moduleOptions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "format": "starts_with",
        "pattern": "^HAIBUN_O_.*"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "steppers"
  ],
  "additionalProperties": {}
