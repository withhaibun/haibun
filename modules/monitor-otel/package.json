{
	"name": "@haibun/monitor-otel",
	"version": "4.0.0-alpha.3",
	"description": "OpenTelemetry monitor for Haibun - exports traces and logs via OTLP",
	"type": "module",
	"main": "build/monitor-otel-stepper.js",
	"files": ["build/"],
	"exports": {
		".": "./build/monitor-otel-stepper.js",
		"./index.js": "./build/monitor-otel-stepper.js",
		"./*": "./build/*"
	},
	"scripts": {
		"build": "tsc -b .",
		"test": "vitest run",
		"docker:up": "docker-compose up -d",
		"docker:down": "docker-compose down"
	},
	"dependencies": {
		"@haibun/core": "*",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/api-logs": "^0.223.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
		"@opentelemetry/resources": "^2.12.0",
		"@opentelemetry/sdk-logs": "^0.223.0",
		"@opentelemetry/sdk-trace-node": "^2.12.0",
		"@opentelemetry/semantic-conventions": "^1.39.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@haibun/logic": "*",
		"@types/node": "^25.3.0"
	}
}
