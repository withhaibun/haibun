{
	"name": "haibun",
	"type": "module",
	"private": false,
	"workspaces": ["modules/*", "e2e-tests"],
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=11.0.0"
	},
	"devDependencies": {
		"@haibun/tooling": "*",
		"@biomejs/biome": "^2.5.15",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^10.0.1",
		"@types/node": "^25.3.0",
		"@vitest/coverage-v8": "^5.0.4",
		"concurrently": "^9.2.1",
		"dependency-cruiser": "^17.3.8",
		"esbuild": "^0.28.2",
		"playwright": "^1.61.1",
		"rollup-plugin-visualizer": "^6.0.5",
		"semantic-release": "^25.0.9",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"scripts": {
		"test": "vitest run",
		"test:e2e": "haibun-cli --groups",
		"test:integration": "vitest run --project integration",
		"start:mcp": "haibun-cli --config mcp-server/config-serving.json mcp-server serve-mcp",
		"test:watch": "vitest --hideSkippedTests",
		"clean": "tsc -b --clean",
		"build": "tsc -b && npm run bundle --workspaces --if-present",
		"build:watch": "concurrently \"tsc -b --watch --preserveWatchOutput\" \"npm run bundle:watch -w @haibun/shu\"",
		"format": "biome format --write .",
		"lint": "biome check . && tsc -b",
		"depcruise": "depcruise -c .dependency-cruiser.cjs -T dot modules | dot -T svg | depcruise-wrap-stream-in-html > dependency-graph.html",
		"prepare": "haibun-install-hooks"
	},
	"version": "4.0.0-alpha.3",
	"overrides": {
		"react": "^19.2.3",
		"@types/react": "^19.0.0",
		"three": "npm:super-three@0.173.5",
		"three-bmfont-text": "3.0.1"
	}
}
