{
	"extends": "./modules/tsconfig.settings.json",
	"compilerOptions": {
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"rootDir": ".",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx"
	},
	"include": ["modules/*/src/**/*.ts", "modules/*/src/**/*.tsx", "modules/*/waypoints/**/*.ts", "modules/*/entries/**/*.ts", "modules/*/scripts/**/*.ts"],
	"exclude": ["**/node_modules/**", "**/build/**"]
}
