{
	"type": "module",
	"private": true,
	"name": "@haibun/e2e-tests",
	"version": "1.56.0",
	"description": "e2e tests for haibun",
	"files": ["build", "local", "publish", "files"],
	"engines": {
		"node": ">=14"
	},
	"scripts": {
		"build:watch": "tsc --watch",
		"build": "tsc",
		"record": "haibun-cli record",
		"test:tests": "HAIBUN_KEY=test haibun-cli tests,@haibun/cli/waypoints,@haibun/web-server-hono/waypoints",
		"test:shu-self-test": "HAIBUN_ENV=shu_test_password=ISECRET_shu_test haibun-cli shu-self-test,@haibun/web-playwright/waypoints",
		"test": "npm run test:tests && npm run test:run-policy && npm run test:shu-self-test",
		"test:requirements": "HAIBUN_CONTINUE_AFTER_ERROR=true haibun-cli requirements,@haibun/cli/waypoints,@haibun/logic/waypoints",
		"test-debug": "npm run test:tests -- --with-steppers=debugger-stepper",
		"test-narrator": "npm run test:tests -- --with-steppers=narrator-stepper",
		"help": "npm run test -- --help",
		"policy:permissive": "haibun-cli -c policy-test/config.json policy-test --run-policy local smoke:w,api:w",
		"policy:restricted:pass": "haibun-cli -c policy-test/config-no-prod-writes.json policy-test --run-policy prod smoke:r,api:r",
		"policy:wildcard:read": "haibun-cli -c policy-test/config.json policy-test --run-policy local \"*:r\"",
		"policy:restricted:fail": "haibun-cli -c policy-test/config-no-prod-writes.json policy-test --run-policy prod smoke:w,api:w",
		"policy:missing:fail": "haibun-cli -c policy-test/config-no-policy.json policy-test --run-policy local smoke:r",
		"policy:none:fail": "haibun-cli -c policy-test/config-no-policy.json policy-test",
		"policy:dry-run": "haibun-cli -c policy-test/config.json policy-test --run-policy local smoke:w,api:w --dry-run",
		"policy:dry-run:no-policy": "haibun-cli policy-test --dry-run",
		"test:run-policy": "npm run policy:permissive && npm run policy:restricted:pass && npm run policy:wildcard:read && npm run policy:dry-run"
	},
	"keywords": [],
	"author": "vid",
	"license": "ISC",
	"dependencies": {
		"@haibun/cli": "*",
		"@haibun/core": "*",
		"@haibun/domain-storage": "*",
		"@haibun/logic": "*",
		"@haibun/monitor-otel": "*",
		"@haibun/monitor-tui": "*",
		"@haibun/out-junit": "*",
		"@haibun/recorder": "*",
		"@haibun/shu": "*",
		"@haibun/storage-fs": "*",
		"@haibun/storage-mem": "*",
		"@haibun/utils": "*",
		"@haibun/web-accessibility-axe": "*",
		"@haibun/web-playwright": "*",
		"@haibun/web-server-hono": "*",
		"@types/express-fileupload": "^1.5.1",
		"express-fileupload": "^1.5.2"
	},
	"devDependencies": {
		"qrcanvas": "^3.1.2"
	}
}
